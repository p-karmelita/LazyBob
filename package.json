{
  "name": "lazybob",
  "version": "1.0.0",
  "description": "AI-Powered Development Accelerator using IBM Bob - Turn ideas into impact faster",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "lazybob": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "node dist/server/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "analyze": "tsx src/core/code-analyzer/cli.ts",
    "generate-docs": "tsx src/core/doc-generator/cli-runner.ts",
    "automate": "tsx src/core/task-automator/cli-runner.ts"
  },
  "keywords": [
    "ibm-bob",
    "ai-development",
    "code-analysis",
    "documentation-generator",
    "task-automation",
    "watsonx",
    "hackathon"
  ],
  "author": {
    "name": "Piotr Karmelita",
    "email": "contact@p-karmelita.dev",
    "url": "https://github.com/p-karmelita"
  },
  "contributors": [
    {
      "name": "Piotr Karmelita",
      "email": "contact@p-karmelita.dev",
      "url": "https://github.com/p-karmelita"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/p-karmelita/LazyBob"
  },
  "bugs": {
    "url": "https://github.com/p-karmelita/LazyBob/issues"
  },
  "homepage": "https://github.com/p-karmelita/LazyBob#readme",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^20.11.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "glob": "^10.3.0",
    "ora": "^8.0.0",
    "prompts": "^2.4.2",
    "ts-morph": "^28.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/ui": "^1.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^1.2.0"
  },
  "optionalDependencies": {
    "@ibm-cloud/watsonx-ai": "^1.0.0",
    "ibm-watson": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
