# IBM Bob Configuration
BOB_TEAM_ID=ibm-hackathon-lablab
BOB_API_KEY=bob_prod_bob-user_5bqEPfHGe4JthamQCyan3hGnkWMBVtauSiyX6tgBAHra3DtwmwPb3kD9G9r5nibXFJqUqHiZRcpkHPzrnHtDNWXg_5ho1pCsFfsh2VZ854qm9QGTeKgtN5NdaC9y4ja3VucFq
BOB_API_ENDPOINT=https://bob-api.example.com

# Use mock mode for testing (uncomment to enable)
# BOB_API_ENDPOINT=mock

# HTTP Client Configuration (optional)
BOB_API_TIMEOUT=30000
BOB_API_RETRIES=3

# IBM watsonx.ai Configuration (Optional)
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_ENDPOINT=https://us-south.ml.cloud.ibm.com

# IBM watsonx Orchestrate Configuration (Optional)
ORCHESTRATE_API_KEY=your_orchestrate_api_key_here
ORCHESTRATE_ENDPOINT=your_orchestrate_endpoint_here

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info

# Feature Flags
ENABLE_WATSONX_AI=false
ENABLE_WATSONX_ORCHESTRATE=false
ENABLE_ADVANCED_ANALYSIS=true
ENABLE_AUTO_DOCUMENTATION=true

# Analysis Configuration
MAX_FILE_SIZE_MB=10
ANALYSIS_TIMEOUT_MS=30000
MAX_CONCURRENT_ANALYSES=5

# Documentation Configuration
DOC_OUTPUT_FORMAT=markdown
INCLUDE_CODE_EXAMPLES=true
GENERATE_DIAGRAMS=true

# Task Automation Configuration
AUTO_COMMIT_CHANGES=false
CREATE_BACKUP_BEFORE_CHANGES=true